pipeline {
    agent any

    stages {
        stage('Make Executable') {
            steps {
                sh 'chmod +x hello.sh'
            }
        }

        stage('Run Script') {
            steps {
                sh './hello.sh'
            }
        }
    }
post {
        always {
            echo 'This always runs.'
        }
        success {
            echo 'This runs on success.'
        }
        failure {
            echo 'This runs on failure.'
        }
        unstable {
            echo 'This runs if the build is unstable.'
        }
        changed {
            echo 'This runs if the build status changes.'
        }
    }
}
